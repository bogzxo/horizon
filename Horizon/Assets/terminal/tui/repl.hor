// The HIDL REPL as a program with a screen of its own, the completion a list drawn by it over the line rather than by
// the terminal. A line run as Enter is pressed and what it came to written over it, Up and Down through the lines run,
// the names that fit the word being typed in a list that Tab takes and Up and Down pick in, Esc puts the list away and
// leaves when there is none.
let ui = include("widgets.hor");

let program = { name: "HIDL" };

let output = [];
let line = ui.field("");
let history = [];
let back = 0;
let offered = [];
let picked = 0;

func say(said, style) {
    for (let piece in said.split("\n")) {
        output.push({ text: piece, style: style });
    }
}

// the word that ends at the caret, letters, digits, _ and the dots between them
func word() {
    let before = line.text.substring(0, line.caret);
    let at = before.length;
    // declared out here, a while doesn't make a new scope every time round the way a for does
    let letter = "";
    while (at > 0) {
        letter = before.substring(at - 1, at);
        if (!"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.".contains(letter)) {
            break;
        }
        at -= 1;
    }
    return before.substring(at);
}

func offer(tui) {
    let typed = word();
    offered = [];
    picked = 0;
    if (typed.length > 0) {
        offered = tui.complete(typed).filter(func(name) { return name != typed; }).slice(0, 8);
    }
}

// the picked name typed in, the rest of it after what was typed (the names come whole, math.floor for math.fl)
func take() {
    let typed = word();
    let name = offered[picked];
    let rest = "";
    if (name.starts_with(typed)) {
        rest = name.substring(typed.length);
    }
    line.text = line.text.substring(0, line.caret) + rest + line.text.substring(line.caret);
    line.caret += rest.length;
    offered = [];
}

func run(tui) {
    let code = line.text;
    say(`hidl > {code}`, "cyan");
    if (code.trim().length > 0) {
        history.push(code);
    }
    back = history.count;
    line = ui.field("");
    offered = [];
    if (code.trim() == "exit") {
        tui.exit(0);
        return;
    }
    if (code.trim().length == 0) {
        return;
    }
    let result = tui.evaluate(code);
    if (result.ok) {
        say(result.text, "default");
    } else {
        say(result.text, "red");
    }
}

func on_start(tui) {
    say("HIDL, a line run as it is given, Tab takes a name from the list, exit or Esc leaves.", "dim");
}

func on_key(tui, key) {
    if (offered.count > 0) {
        if (key.name == "tab") {
            take();
            return;
        }
        if (key.name == "down") {
            picked = (picked + 1) % offered.count;
            return;
        }
        if (key.name == "up") {
            picked = (picked + offered.count - 1) % offered.count;
            return;
        }
        if (key.name == "escape") {
            offered = [];
            return;
        }
    }

    if (key.name == "escape") {
        tui.exit(0);
        return;
    }
    if (key.name == "enter") {
        run(tui);
        return;
    }
    if (key.name == "up" && history.count > 0) {
        back = math.max(0, back - 1);
        line = ui.field(history[back]);
        return;
    }
    if (key.name == "down" && history.count > 0) {
        back = math.min(history.count, back + 1);
        if (back == history.count) {
            line = ui.field("");
        } else {
            line = ui.field(history[back]);
        }
        return;
    }

    if (ui.field_key(line, key)) {
        offer(tui);
    }
}

func draw(tui) {
    tui.clear();
    let parts = ui.rows(ui.screen(tui), [0, 1]);
    let room = parts[0].h;
    let first = math.max(0, output.count - room);
    let row = 0;
    for (let i in range(first, output.count)) {
        tui.write(0, row, ui.clip(output[i].text, parts[0].w), output[i].style);
        row += 1;
    }

    tui.write(0, parts[1].y, "hidl > ", "magenta");
    ui.field_draw(tui, line, ui.rect(7, parts[1].y, parts[1].w - 7, 1), "", true);

    // the names that fit, over the line, starting where the word does
    if (offered.count > 0) {
        let x = math.min(7 + line.caret - word().length, math.max(0, tui.columns() - 20));
        let height = offered.count + 2;
        ui.menu_draw(tui, offered, picked, x, math.max(0, parts[1].y - height));
    }
}
