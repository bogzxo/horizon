// Files, a file picker, what Ctrl+P is in Hex, in a terminal. The folder the shell was in, narrowed down by what is
// typed (the letters in order), Enter goes into a folder or opens a file to edit, Tab puts the path on the prompt of
// the shell it was started from, Backspace with nothing typed goes up a folder, Alt+H shows the hidden ones.
let ui = include("widgets.hor");

let program = { name: "Files" };

let here = "";
let entries = [];
let shown = ui.list([]);
let filter = ui.field("");
let hidden = false;

func load(tui, folder, pick) {
    here = folder;
    entries = tui.files(folder);
    filter = ui.field("");
    narrow();
    shown.selected = 0;
    shown.top = 0;
    // coming up out of a folder, that folder is the one picked
    if (pick != null) {
        let at = 0;
        for (let entry in shown.items) {
            if (entry.path == pick) {
                shown.selected = at;
            }
            at += 1;
        }
    }
}

func narrow() {
    let typed = filter.text;
    ui.list_set(shown, entries.filter(func(entry) { return (hidden || !entry.hidden) && ui.matches(entry.name, typed); }));
}

func quoted(path) {
    if (path.contains(" ")) {
        return `"{path}"`;
    }
    return path;
}

func on_start(tui) {
    load(tui, tui.folder(), null);
}

func on_key(tui, key) {
    let area = ui.screen(tui);
    if (key.name == "escape") {
        if (filter.text.length > 0) {
            filter = ui.field("");
            narrow();
        } else {
            tui.exit(0);
        }
        return;
    }

    if (key.name == "enter") {
        let chosen = ui.list_chosen(shown);
        if (chosen == null) {
            return;
        }
        if (chosen.folder) {
            load(tui, chosen.path, null);
        } else {
            tui.open(chosen.path, 0);
            tui.exit(0);
        }
        return;
    }

    if (key.name == "tab") {
        let chosen = ui.list_chosen(shown);
        if (chosen != null) {
            tui.type(quoted(chosen.path) + " ");
            tui.exit(0);
        }
        return;
    }

    if (key.name == "backspace" && filter.text.length == 0) {
        let up = tui.parent(here);
        if (up != null) {
            load(tui, up, here);
        }
        return;
    }

    if (key.alt && key.name == "h") {
        hidden = !hidden;
        narrow();
        return;
    }

    if (ui.list_key(shown, key, area.h - 4)) {
        return;
    }

    if (ui.field_key(filter, key)) {
        narrow();
    }
}

func draw(tui) {
    let parts = ui.rows(ui.screen(tui), [1, 1, 0, 1]);
    tui.write(0, 0, ui.pad(` {here}`, parts[0].w), "bold cyan");
    tui.write(0, 1, " > ", "cyan");
    ui.field_draw(tui, filter, ui.rect(3, 1, parts[1].w - 3, 1), "a few letters narrow it down", true);

    let columns = [
        { title: "name", width: 0, get: func(entry) { if (entry.folder) { return entry.name + "\\"; } return entry.name; } },
        { title: "size", width: 10, get: func(entry) { if (entry.folder) { return ""; } return ui.size(entry.size); } },
        { title: "changed", width: 18, get: func(entry) { return entry.modified; } }
    ];
    ui.table_draw(tui, shown, parts[2], columns, true);
    ui.status(tui, parts[3], "enter open  tab to the shell  backspace up  alt+h hidden  esc leave", `{shown.items.count} of {entries.count}`);
}
