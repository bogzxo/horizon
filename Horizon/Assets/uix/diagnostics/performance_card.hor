// The performance overlay with everything in it (PerformanceDetail.Full), the card. Open it in Hex.
//
// The engine finds the parts by their names and writes the numbers into them four times a second
// (UI/Diagnostics/PerformanceFace.cs), so a part can be moved, made bigger, coloured or put in another section and
// keeps working, as long as it keeps its name and stays the kind of thing it is. One that is taken out is a line
// in the log and a number nobody sees. Whatever changes all the time is a readout and not a label, a readout
// takes a new number without making a string of it, and this is the corner of the screen that counts the garbage.
//
// The card is a stack of two columns. On a screen tall enough for the lot they are put one under the other (the
// engine turns the stack), on a short one they stay side by side. The lines of the GPU's passes are not in here,
// they are performance_pass.hor, one copy for every pass.
#define layout

let card = compositor.stack({
    padding: 14,
    spacing: 6,
    direction: "horizontal",
    color: vec(0.05, 0.058, 0.082, 0.96),
    radius: 10,
    outline: vec(1, 1, 1, 0.09)
});

let left = compositor.stack({
    parent: card,
    anchor: "top",
    spacing: 6
});

let middle = compositor.divider({
    parent: card,
    direction: "vertical",
    fill: "vertical",
    color: vec(1, 1, 1, 0.075)
});

let right = compositor.stack({
    parent: card,
    anchor: "top",
    spacing: 6
});

let header = compositor.panel({
    parent: left,
    size: vec(404, 50)
});

let starting = compositor.label({
