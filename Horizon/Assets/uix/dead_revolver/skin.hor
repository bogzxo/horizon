// The Dead Revolver skin, the look of every UI unless it asks for another one.
//
// It comes in a number of themes, the same art in another colour. Everything up to "themes" is what they have in
// common; under "themes" every one of them lists only what it does differently, and whoever loads the skin says
// which one they want (the one called "theme" if they don't).
//
// The art is looked up in sprites.hor by name, in the theme of the skin. Components find the sprites that are named
// after what they ask for by themselves (a button asks for "button", "button_hover" and "button_pressed"), so only
// what goes by another name in the pack is listed under regions. A region is the name of a sprite, or an object
// when there is more to say: { sprite: "bar_fill", tint: vec(r, g, b, a) }.
//
// Icons are what [icon:name] in a text draws. Every sprite is an icon by its own name already, the ones listed here
// are for giving a sprite a shorter name, or for making an icon out of a blank sprite with a tint and a label:
// a white round button in green with an A on it is the A button of a gamepad.
// An icon can also carry a symbol, another sprite drawn small in the middle of it, which is how the buttons of a
// PlayStation gamepad are made: there is no letter for a triangle.
// Every icon is drawn as tall as the line of text it is in. Icons that belong together but whose art isn't all the
// same height (the arrows, up and down are flatter than left and right) say how many pixels of art make a line with
// height, which draws them all at the one scale.
//
// A set of icons (icon_sets) says what some icons are called on another gamepad, or on a keyboard. A text that starts
// with [icons:playstation] is written with the names on the left, as always, and shows the icons on the right.
// An icon whose sprite has frames animates in the text, which is how the buttons blink a press now and then.

let skin = {
    sprites: "sprites.hor",
    theme: "blue",
    font: { dir: "Assets/fonts/klaxon_mono/", file: "klaxon_mono.fnt" },

    art_scale: 3,
    text_scale: 0.4,
    text_color: vec(0.93, 0.95, 1.0, 1.0),
    control_text_color: vec(1.0, 1.0, 1.0, 1.0),
    panel_color: vec(0.04, 0.04, 0.07, 0.94),
    track_color: vec(0.0, 0.0, 0.0, 0.0),
    hover_color: vec(1.0, 1.0, 1.0, 0.1),
    disabled_tint: vec(1.0, 1.0, 1.0, 0.4),
    icon_label_color: vec(1.0, 1.0, 1.0, 1.0),
    icon_scale: 1.33,

    button_padding: vec(18, 12),
    progress_inset: vec(6, 6, 6, 9),
    progress_fill_over_frame: true,
    toggle_size: 24,
    spacing: 12,

    regions: {
        progress_frame: "bar_frame",
        progress_fill: "bar_fill",
        toggle_on: "check_on",
        toggle_off: "check_off",
        slider_handle: "slider_knob",
        textbox: "button_outline",
        textbox_focused: "button_outline_selected",
        selection: "selector"
    },

    icons: {
        heart: "heart",
        star: "star_flat",
        check: "round_check",
        cross: "round_cross",
        plus: "round_plus",
        minus: "round_minus",
        up: { sprite: "arrow_up", height: 8 },
        down: { sprite: "arrow_down", height: 8 },
        left: { sprite: "arrow_left", height: 8 },
        right: { sprite: "arrow_right", height: 8 },
        lock: "icon_lock",
        sword: "icon_sword",
        shield: "icon_shield",

        // The gamepads, out of the gdb art. Written with the names of an Xbox gamepad, a text that starts with
        // [icons:playstation] shows the PlayStation ones instead (see icon_sets)
        pad_a: "xbox_a",
        pad_b: "xbox_b",
        pad_x: "xbox_x",
        pad_y: "xbox_y",
        pad_lb: "xbox_lb",
        pad_rb: "xbox_rb",
        pad_lt: "xbox_lt",
        pad_rt: "xbox_rt",
        pad_ls: "xbox_ls",
        pad_rs: "xbox_rs",
        pad_view: "xbox_view",
        pad_menu: "xbox_menu",
        pad_home: "xbox_home",
        dpad: "xbox_dpad",
        dpad_up: "xbox_dpad_up",
        dpad_down: "xbox_dpad_down",
        dpad_left: "xbox_dpad_left",
        dpad_right: "xbox_dpad_right",
        stick_up: { sprite: "xbox_stick_up", height: 12 },
        stick_down: { sprite: "xbox_stick_down", height: 12 },
        stick_left: { sprite: "xbox_stick_left", height: 12 },
        stick_right: { sprite: "xbox_stick_right", height: 12 },

        // The mouse, for prompts on a PC. The keys of the keyboard are icons by their own names, [icon:key_w] and so on
        mouse_left: { sprite: "mouse_left", height: 28 },
        mouse_right: { sprite: "mouse_right", height: 28 },
        mouse_middle: { sprite: "mouse_middle", height: 28 },
        mouse_wheel: "mouse_wheel"
    },

    icon_sets: {
        playstation: {
            pad_a: "ps_cross",
            pad_b: "ps_circle",
            pad_x: "ps_square",
            pad_y: "ps_triangle",
            pad_lb: "ps_l1",
            pad_rb: "ps_r1",
            pad_lt: "ps_l2",
            pad_rt: "ps_r2",
            pad_ls: "ps_l3",
            pad_rs: "ps_r3",
            pad_view: "ps_share",
            pad_menu: "ps_options",
            pad_home: "ps_touchpad"
        },

        // A keyboard player, where the buttons of a gamepad usually end up
        keyboard: {
            pad_a: "key_space",
            pad_b: "key_esc",
            pad_x: "key_e",
            pad_y: "key_tab",
            pad_lb: "key_q",
            pad_rb: "key_r",
            pad_lt: "mouse_right",
            pad_rt: "mouse_left",
            pad_ls: "key_shift",
            pad_rs: "key_ctrl",
            pad_view: "key_backspace",
            pad_menu: "key_enter",
            dpad_up: "key_w",
            dpad_down: "key_s",
            dpad_left: "key_a",
            dpad_right: "key_d",
            stick_up: "key_up",
            stick_down: "key_down",
            stick_left: "key_left",
            stick_right: "key_right"
        }
    },

    themes: {
        blue: {
            accent_color: vec(0, 0.86, 1, 1.0),
            regions: { progress_fill: { sprite: "bar_fill", tint: vec(0, 0.86, 1, 1.0) } }
        },
        purple: { accent_color: vec(0.71, 0.59, 0.94, 1.0) },
        red: { accent_color: vec(0.92, 0.27, 0.23, 1.0) },
        gold: { accent_color: vec(0.94, 0.81, 0.63, 1.0) },
        tan: {
            accent_color: vec(0.84, 0.65, 0.53, 1.0),
            regions: { progress_fill: { sprite: "bar_fill", tint: vec(0.84, 0.65, 0.53, 1.0) } }
        },
        white: {
            accent_color: vec(0.72, 0.77, 0.84, 1.0),
            bar_text_color: vec(0.08, 0.09, 0.13, 1.0),
            text_shadow_color: vec(1.0, 1.0, 1.0, 0.0)
        }
    }
}
