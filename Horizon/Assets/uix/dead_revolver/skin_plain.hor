// The Dead Revolver skin with a plain font in place of its own: the same art, themes and colours, for UIs with a
// lot of small text to read, such as tools.
//
// The font is a pixel font drawn 8 times its size, so text is at its sharpest at a scale that is a whole multiple
// of 0.125 on a UI that isn't scaled to its window by anything else than a whole number.

let skin = {
    inherit: "skin.hor",
    font: { dir: "fonts/vcr_mono/", file: "vcr_mono.fnt" },
    text_scale: 0.25
};
