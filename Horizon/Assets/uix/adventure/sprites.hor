// Whatever isn't in here (the gamepads, the keyboard, the hearts and stars, the cursors) is Dead Revolver's,
// at the three times its size it was drawn for whatever this skin draws its own art at.
let sheet = {
    images: { art },
    inherit: { sheet: "../dead_revolver/sprites.hor", scale: 3 }
}
