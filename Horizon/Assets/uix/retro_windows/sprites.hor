// The sprites of the Retro Windows skin, cut out of Retro Windows GUI by Comp-3 Interactive
// (comp3interactive.itch.io/retro-windows-gui) by Art/make_ui_packs.py, which is where to change anything in here,
// this file is written by it. The pack is a folder of small PNGs, a button fifteen pixels across and so on. They
// are all on the one sheet here, art.aseprite, with a colour scheme on every layer. The pack comes in the one
// everybody remembers (classic), the others are the same art with its six colours swapped for another six, the
// way the schemes of the real thing were.
//
// The names are the ones the components and the layouts ask for, which are Dead Revolver's, so a layout written
// for that skin comes up in this one. A pack this small has one button and one field, so a lot of names are the
// same picture.

let art = {
    file: "art.aseprite",
    themes: "layers",
    fallback: "classic",
    sprites: {
        button:                 { x: 1, y: 1, w: 15, h: 15, border: 2, content: vec(4, 3, 4, 4) },
        button_hover:           { x: 17, y: 1, w: 15, h: 15, border: 2, content: vec(4, 3, 4, 4) },
        button_pressed:         { x: 33, y: 1, w: 15, h: 15, border: 2, content: vec(4, 3, 4, 4) },
