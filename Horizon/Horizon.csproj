<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The engine, all of it in one library. Logging, the core (entities, threading, windowing), content management,
    the Vulkan device, input, the engine itself, rendering, the UI and physics. Each keeps its own
    namespace (Horizon.Core, Horizon.Rendering, Horizon.UI, ...) and folder, but there is nothing between them that
    can't see the rest, so the UI can be used by the engine's own debugging and the physics draws its outlines with
    the renderer's primitives. Only the scripting language (Horizon.HIDL) is a project of its own, as it has an
    editor that wants nothing of the engine.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Horizon</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <IsPublishable>false</IsPublishable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Nullable advice in code that predates it, and the trimming notes of the HIDL reflection, are not errors -->
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
  </PropertyGroup>

  <!--
    The Skyline debugger (the menu bar, the scene tree, the inspector, the content browser) is for whoever is making
    the game, not for whoever plays it. A Release build doesn't compile a line of it.
  -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Engine\Debugging\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotTiled" Version="1.0.0" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input.Extensions" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input.Sdl" Version="2.23.0" />
    <PackageReference Include="Silk.NET.SDL" Version="2.23.0" />
    <PackageReference Include="Slangc.NET" Version="2026.19.0" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    <!-- A Mac's Vulkan, so nobody has to install the SDK to play. Nothing on the other platforms -->
    <PackageReference Include="Silk.NET.MoltenVK.Native" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing.Sdl" Version="2.23.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.13" />
    <!-- TextMate grammars for the code editor, VS Code's own, and the Oniguruma they are written against (Onigwrap, native, every platform) -->
    <PackageReference Include="TextMateSharp" Version="2.0.4" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Horizon.HIDL\Horizon.HIDL.csproj" />
  </ItemGroup>

  <!--
    What the engine needs next to it at run time, at the same paths whichever game it is in: its shaders, the fonts
    the UI comes with and the UI skins. A game that packs itself into one file
    (see Fighter2D) picks these up from here.
  -->
  <ItemGroup>
    <None Update="shaders\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\global\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\fonts\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\uix\**\*.aseprite;Assets\uix\**\*.hor;Assets\uix\**\README.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Horizon.Tests" />
    <InternalsVisibleTo Include="Horizon.Testing" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\global\loading.aseprite">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
