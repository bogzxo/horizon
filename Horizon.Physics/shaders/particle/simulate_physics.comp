#version 460 core

// The particles of a PhysicsParticleSimulator2D: simulate.comp, plus running into the map and the dynamic bodies
// of a physics world. What there is to run into is uploaded by the simulator, see PhysicsParticleFeed.

// Must match ComputeParticleSimulator2D.WorkGroupSize.
layout(local_size_x = 256) in;

// Must match PhysicsParticleSimulator2D.MaxImpulses.
#define MAX_IMPULSES 8

// How far a fast particle's step can be split up, so it can't skip through a tile.
#define MAX_SUBSTEPS 8

// Being pushed out of one shape can push into the next (a body pressing into the floor).
#define SOLVER_PASSES 2

// Slower than this into a surface and the particle stays down instead of bouncing.
#define REST_SPEED 45.0

// Must match ParticleState2D (24 bytes).
struct Particle {
  vec2 position;
  vec2 velocity;
  float life; // 1 at birth, <= 0 once dead
  float rate; // per-particle ageing multiplier
};

// Must match PhysicsGpuShape (32 bytes).
struct Shape {
  vec2 min; // the box around the shape, for rectangles this is the shape itself
  vec2 max;
  vec2 velocity; // how fast the body it belongs to is moving, zero for the map
  float radius;
  float circle; // 1 for a circle, 0 for a rectangle
};

layout(std430, binding = 0) buffer ParticleBuffer {
  Particle particles[];
};

layout(std430, binding = 1) readonly buffer MapShapeBuffer {
  Shape mapShapes[];
};

// The map is sorted into a grid: the shapes touching cell i are
// mapCells[uMapCellCount + 1 + mapCells[i]] up to mapCells[uMapCellCount + 1 + mapCells[i + 1]].
layout(std430, binding = 2) readonly buffer MapCellBuffer {
  int mapCells[];
};

layout(std430, binding = 3) readonly buffer BodyBuffer {
  Shape bodies[];
};

uniform uint uFirst;
uniform uint uCount;

uniform float uDeltaTime;
uniform float uInvMaxAge;
uniform vec2 uGravity;

uniform float uRadius;
uniform float uRestitution;
uniform float uFriction;
uniform float uLinearDrag;

// How much of the speed of a body a particle takes on when it is shoved out of the way, and the most that can be.
uniform float uBodyPush;
uniform float uBodyPushLimit;

uniform vec2 uMapOrigin;
uniform int uMapWidth; // in cells, 0 for no map at all
uniform int uMapHeight;
uniform int uMapCellCount;
uniform float uMapCellSize;

// A particle outside of this box has fallen off the map and has nothing left to land on.
uniform vec2 uLostMin;
uniform vec2 uLostMax;

// The box around all of the bodies, already grown by the radius of a particle.
uniform int uBodyCount;
uniform vec2 uBodiesMin;
uniform vec2 uBodiesMax;

// xy: centre, z: radius, w: impulse / mass
uniform int uImpulseCount;
uniform vec4 uImpulses[MAX_IMPULSES];

// Tests a circle (a particle) against a shape: the way it has to be pushed to get out, and how far.
bool overlaps(Shape shape, vec2 position, out vec2 normal, out float depth) {
  const float epsilon = 0.0001;

  normal = vec2(0.0, 1.0);
  depth = 0.0;

  // Cheap test first, nearly every shape we get asked about is nowhere near.
  if (any(lessThan(position + uRadius, shape.min)) || any(greaterThan(position - uRadius, shape.max))) return false;

  if (shape.circle > 0.5) {
    vec2 away = position - (shape.min + shape.max) * 0.5;
    float distance = length(away);
    float reach = uRadius + shape.radius;

    if (distance >= reach) return false;

    if (distance > epsilon) normal = away / distance;
    depth = reach - distance;
    return true;
  }

  // Find the closest point of the rectangle, we are touching if that is within our radius.
  vec2 offset = position - clamp(position, shape.min, shape.max);
  float offsetSquared = dot(offset, offset);

  if (offsetSquared > uRadius * uRadius) return false;

  if (offsetSquared > epsilon) {
    float distance = sqrt(offsetSquared);
    normal = offset / distance;
    depth = uRadius - distance;
    return true;
  }

  // Our centre is inside the rectangle, leave through whichever side is nearest.
  float left = position.x - shape.min.x, right = shape.max.x - position.x;
  float down = position.y - shape.min.y, up = shape.max.y - position.y;
  float nearest = min(min(left, right), min(down, up));

  if (nearest == up) normal = vec2(0.0, 1.0);
  else if (nearest == down) normal = vec2(0.0, -1.0);
  else if (nearest == left) normal = vec2(-1.0, 0.0);
  else normal = vec2(1.0, 0.0);

  depth = nearest + uRadius;
  return true;
}

bool contains(Shape shape, vec2 point) {
  if (any(lessThanEqual(point, shape.min)) || any(greaterThanEqual(point, shape.max))) return false;

  vec2 away = point - (shape.min + shape.max) * 0.5;
  return shape.circle < 0.5 || dot(away, away) < shape.radius * shape.radius;
}

// Gets a particle out of whatever it ran into, and works out the speed it leaves with.
void respond(inout Particle p, vec2 normal, float depth, vec2 surfaceVelocity, float slide, float restitution) {
  p.position += normal * depth;

  // Everything from here is as seen from the surface, so hitting a moving body works just like hitting the floor.
  vec2 velocity = p.velocity - surfaceVelocity;
  float into = dot(velocity, normal);

  // Already on our way out.
  if (into >= 0.0) return;

  // Take away the speed going into the surface, and give some back if it was a hard enough hit to bounce.
  float bounce = -into > REST_SPEED ? restitution : 0.0;
  velocity -= normal * (into * (1.0 + bounce));

  // Whatever is left along the surface is slowed by friction.
  vec2 tangent = velocity - normal * dot(velocity, normal);
  velocity -= tangent * (1.0 - slide);

  p.velocity = velocity + surfaceVelocity;
}

// Finds the cells of the map a box reaches into, false if it is entirely off the map.
bool mapCellsOf(vec2 low, vec2 high, out ivec2 first, out ivec2 last) {
  ivec2 size = ivec2(uMapWidth, uMapHeight);
  first = last = ivec2(0);

  if (uMapWidth == 0 ||
      any(lessThan(high, uMapOrigin)) ||
      any(greaterThan(low, uMapOrigin + vec2(size) * uMapCellSize))) return false;

  first = clamp(ivec2((low - uMapOrigin) / uMapCellSize), ivec2(0), size - 1);
  last = clamp(ivec2((high - uMapOrigin) / uMapCellSize), ivec2(0), size - 1);
  return true;
}

bool collideWithMap(inout Particle p, float slide) {
  ivec2 first, last;
  if (!mapCellsOf(p.position - uRadius, p.position + uRadius, first, last)) return false;

  bool touched = false;
  for (int y = first.y; y <= last.y; y++) {
    for (int x = first.x; x <= last.x; x++) {
      int cell = y * uMapWidth + x;
      int end = mapCells[cell + 1];

      for (int entry = mapCells[cell]; entry < end; entry++) {
        vec2 normal;
        float depth;
        if (!overlaps(mapShapes[mapCells[uMapCellCount + 1 + entry]], p.position, normal, depth)) continue;

        respond(p, normal, depth, vec2(0.0), slide, uRestitution);
        touched = true;
      }
    }
  }

  return touched;
}

bool collideWithBodies(inout Particle p, float slide) {
  bool touched = false;
  for (int i = 0; i < uBodyCount; i++) {
    vec2 normal;
    float depth;
    if (!overlaps(bodies[i], p.position, normal, depth)) continue;

    // Bodies are a lot faster than anything a particle does by itself, taking on all of their speed has the
    // particles fired off rather than pushed aside.
    vec2 push = bodies[i].velocity * uBodyPush;
    float speed = length(push);
    if (speed > uBodyPushLimit) push *= uBodyPushLimit / speed;

    // A body is soft compared to the map: nothing bounces off of it.
    respond(p, normal, depth, push, slide, 0.0);
    touched = true;
  }

  return touched;
}

// Tests if a point is inside of anything of the map.
bool mapContains(vec2 point) {
  ivec2 cell, unused;
  if (!mapCellsOf(point, point, cell, unused)) return false;

  int index = cell.y * uMapWidth + cell.x;
  int end = mapCells[index + 1];

  for (int entry = mapCells[index]; entry < end; entry++) {
    if (contains(mapShapes[mapCells[uMapCellCount + 1 + entry]], point)) return true;
  }

  return false;
}

void main() {
  // The last work group is padded past the end of the range.
  if (gl_GlobalInvocationID.x >= uCount) return;

  uint index = uFirst + gl_GlobalInvocationID.x;

  Particle p = particles[index];
  if (p.life <= 0.0) return;

  p.life -= uDeltaTime * p.rate * uInvMaxAge;

  // A particle that gravity has taken past the edge of the map has nothing left to land on.
  if (any(lessThan(p.position, uLostMin)) || any(greaterThan(p.position, uLostMax))) p.life = 0.0;

  if (p.life <= 0.0) {
    particles[index] = p;
    return;
  }

  // The pushes that were asked for since the last time: away from their centre, the closer the harder.
  for (int i = 0; i < uImpulseCount; i++) {
    vec2 away = p.position - uImpulses[i].xy;
    float distance = length(away);
    if (distance >= uImpulses[i].z) continue;

    // Anything sat exactly on the centre goes straight up.
    vec2 direction = distance > 0.0001 ? away / distance : vec2(0.0, 1.0);
    p.velocity += direction * (uImpulses[i].w * (1.0 - distance / uImpulses[i].z));
  }

  p.velocity = (p.velocity + uGravity * uDeltaTime) * max(0.0, 1.0 - uLinearDrag * uDeltaTime);

  // Never move further than this without testing for collisions, the fast ones get their step split up.
  float safeDistance = max(uRadius, 4.0);
  int substeps = clamp(int(ceil(length(p.velocity) * uDeltaTime / safeDistance)), 1, MAX_SUBSTEPS);
  float substepTime = uDeltaTime / float(substeps);
  float slide = max(0.0, 1.0 - uFriction * uDeltaTime);

  bool nearBodies = uBodyCount > 0;

  for (int step = 0; step < substeps; step++) {
    vec2 before = p.position;
    p.position += p.velocity * substepTime;

    // Most particles are nowhere near a body, one box around all of them rules those out in a single test.
    bool reachable = nearBodies &&
        all(greaterThanEqual(p.position, uBodiesMin)) && all(lessThanEqual(p.position, uBodiesMax));

    bool touchedAnything = false;
    for (int pass = 0; pass < SOLVER_PASSES; pass++) {
      bool touched = collideWithMap(p, slide);
      if (reachable && collideWithBodies(p, slide)) touched = true;

      if (!touched) break;
      touchedAnything = true;
    }

    // Being pushed out of one tile can end inside the one next to it, and a body can press a particle into the floor
    // harder than the floor pushes back. The map always wins: rather than end up inside of it the particle stays
    // where it was. Unless it was inside already (spawned there), then it has to be let out.
    if (touchedAnything && mapContains(p.position) && !mapContains(before)) {
      p.position = before;
      p.velocity = vec2(0.0);
      break;
    }
  }

  particles[index] = p;
}
