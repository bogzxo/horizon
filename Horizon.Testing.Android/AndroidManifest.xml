<?xml version="1.0" encoding="utf-8"?>
<!--
  The activity itself is declared by its [Activity] attribute in TestingActivity.cs. Vulkan 1.3 is what the engine's
  device asks for (0x403000 is VK_MAKE_API_VERSION(0, 1, 3, 0)), which only filters a store, adb installs regardless and
  the engine says on screen what's missing. Back goes through OnBackInvokedDispatcher, see HorizonActivity.Input.cs.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-feature android:name="android.hardware.vulkan.version" android:version="0x403000" android:required="true" />
  <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
  <uses-feature android:name="android.hardware.gamepad" android:required="false" />
  <application android:label="Horizon Testing" android:allowBackup="false" android:enableOnBackInvokedCallback="true" />
</manifest>
