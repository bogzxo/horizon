<Project>
  <!-- Preserve workspace or consuming repository properties when this checkout is nested. -->
  <PropertyGroup>
    <HorizonParentProps>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))</HorizonParentProps>
  </PropertyGroup>
  <Import Project="$(HorizonParentProps)" Condition="'$(HorizonParentProps)' != '' and Exists('$(HorizonParentProps)')" />

  <!-- Keep the engine and its companion assemblies on the same release version. -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('Horizon'))">
    <Version>2.0.0</Version>
  </PropertyGroup>

  <!--
    The NuGet packages: every Horizon.* library, the scripting language, the engine, the UI, the terminal, the editor's
    tooling and the platforms (desktop, Android, iOS), which is what a game or an editor needs to be built against the
    engine without a checkout of it beside it, and the shader pack builder as a dotnet tool. scripts/pack.ps1 makes them.
    The tests, the examples and the test and probe apps on a phone are not packages. Their IDs start with bogzxo.
    because somebody else has reserved the Horizon prefix on nuget.org; the engine's assembly is Horizon and so is its
    project, its package is bogzxo.Horizon.Engine. Horizon.HIDL is a submodule with no props of its own, so it gets its
    package from here as well.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('Horizon'))">
    <IsPackable>false</IsPackable>
    <HorizonPackage>false</HorizonPackage>
    <HorizonPackage Condition="'$(MSBuildProjectName)' == 'Horizon' or '$(MSBuildProjectName)' == 'Horizon.HIDL' or '$(MSBuildProjectName)' == 'Horizon.UI' or '$(MSBuildProjectName)' == 'Horizon.Terminal' or '$(MSBuildProjectName)' == 'Horizon.Tooling' or '$(MSBuildProjectName)' == 'Horizon.Shaders.Build'">true</HorizonPackage>
    <HorizonPackage Condition="$(MSBuildProjectName.StartsWith('Horizon.Platform.'))">true</HorizonPackage>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HorizonPackage)' == 'true'">
    <IsPackable>true</IsPackable>
    <PackageId>bogzxo.$(MSBuildProjectName)</PackageId>
    <Authors>bogzxo</Authors>
    <RepositoryUrl>https://github.com/bogzxo/horizon</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/bogzxo/horizon</PackageProjectUrl>
    <PackageTags>horizon;game-engine;vulkan;ui;hidl</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <HorizonPackageReadme>$(MSBuildThisFileDirectory)docs\nuget-readme.md</HorizonPackageReadme>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Horizon'">
    <PackageId>bogzxo.Horizon.Engine</PackageId>
    <Description>The Horizon engine's runtime: the Vulkan renderer, content, input, audio, entities and physics, with the shaders, fonts and UI skins it needs beside a program at run time.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Horizon.HIDL'">
    <RepositoryUrl>https://github.com/bogzxo/hidl</RepositoryUrl>
    <PackageProjectUrl>https://github.com/bogzxo/hidl</PackageProjectUrl>
    <Description>HIDL, the Horizon engine's scripting language: its lexer, parser, compiler and virtual machine, with nothing of the engine in it.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Horizon.UI'">
    <Description>The Horizon engine's UI: the compositor, components and controls, skins, layouts and the scripts that build them, the code editor and Scene2D.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Horizon.Platform.Desktop'">
    <Description>The Horizon engine on Windows, macOS and Linux: the window, keyboard, mouse and controllers, audio, and MoltenVK for a Mac.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Horizon.Platform.Android'">
    <Description>The Horizon engine on Android: the SurfaceView's window for Vulkan, the APK's assets, the app's storage, AAudio, and HorizonActivity for a game's activity to derive from.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Horizon.Platform.iOS'">
    <Description>The Horizon engine on iOS: the Metal view for Vulkan over MoltenVK, touch, keyboard and controllers, audio, the bundle's content and the app's storage, and HorizonAppDelegate for a game's app to derive from.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Horizon.Terminal'">
    <Description>The Horizon engine's terminal: the VT parser, the screen, the views and panes, and the host with its plugins, profiles, sessions and shell integration.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Horizon.Tooling'">
    <Description>What an editor built on Horizon needs and a game doesn't: the language server client and the debug adapter client.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Horizon.Shaders.Build'">
    <Description>Makes a Horizon shader pack out of a manifest, for a platform with no Slang to compile with (a phone). A dotnet tool, horizon-shaders.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>horizon-shaders</ToolCommandName>
  </PropertyGroup>
</Project>
