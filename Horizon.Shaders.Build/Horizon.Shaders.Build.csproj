<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Makes a shader pack out of a manifest, for a platform that has no Slang to compile with (a phone). It compiles with
    the engine's own ShaderCompiler, so a pack made here has the keys and the modules a game would have made itself.
    Run on a desktop with the sources, see Program.cs for how.
  -->

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Horizon\Horizon.csproj" />
  </ItemGroup>

</Project>
