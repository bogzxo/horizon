// The look of the UI.
// A region says where a piece of art sits in the texture, in pixels from the top left corner.
// Its border is how much of each edge keeps its size when the art is stretched: a number for all
// four sides, vec(horizontal, vertical), or vec(left, top, right, bottom).
// Everything apart from the texture can be left out.

let skin = {
    texture: "example_ui.png",
    font: { dir: "fonts/klaxon_mono/", file: "klaxon_mono.fnt" },

    text_scale: 0.4,
    text_color: vec(0.93, 0.95, 1.0, 1.0),
    control_text_color: vec(0.08, 0.09, 0.13, 1.0),
    panel_color: vec(0.1, 0.12, 0.17, 0.92),
    hover_color: vec(1.0, 1.0, 1.0, 0.22),
    disabled_tint: vec(1.0, 1.0, 1.0, 0.4),

    button_padding: vec(16, 10),
    progress_inset: vec(7, 6),
    toggle_size: 30,
    spacing: 10,

    regions: {
        button: { x: 0, y: 32, w: 128, h: 64, border: 6 },
        button_pressed: { x: 128, y: 32, w: 128, h: 64, border: 6 },
        progress_frame: { x: 256, y: 33, w: 256, h: 62, border: 24 },
        progress_fill: { x: 512, y: 39, w: 256, h: 50 },
        toggle_on: { x: 768, y: 0, w: 128, h: 128 },
        toggle_off: { x: 896, y: 0, w: 128, h: 128 }
    }
}
