// The gamepads and the keyboard, by greatdocbrown (the gdb images). Every button comes as it sits and then as four
// frames of being pressed, which is what a sprite of five frames is, so an icon of one blinks a press now and then.
// "name_pressed" is the button held down, for a key of a keyboard on screen.
// Where a button sits, and where its four frames start
func pressable(sprites, name, x, y, frames_x, w, h) {
    sprites[name] = { x: x, y: y, w: w, h: h, frames: [vec(frames_x, y), vec(frames_x + w, y), vec(frames_x + w * 2, y), vec(frames_x + w * 3, y)], time: 0.12 };
    sprites[name + "_pressed"] = { x: frames_x + w, y: y, w: w, h: h };
}

