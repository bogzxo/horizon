// The keyboard and the mouse. The sheet has the whole keyboard four times, one under the other, as the frames of a
// key being pressed: the key as it sits, going down, down, and back up. A key is 16 by 16 in a grid of 16, the wide
// ones 24 and the space bar 104. The four keyboards aren't quite the same distance apart, so every key lists its frames.
let keyboard = {
    file: "gdb-keyboard.png",
    sprites: {
        mouse:        { x: 505, y: 146, w: 15, h: 28 },
        mouse_left:   { x: 537, y: 146, w: 15, h: 28 },
        mouse_middle: { x: 505, y: 178, w: 15, h: 28 },
        mouse_right:  { x: 537, y: 178, w: 15, h: 28 },
        mouse_wheel:  { x: 453, y: 193, w: 22, h: 15 },
        scroll_up:    { x: 462, y: 161, w: 4, h: 15 },
        scroll_down:  { x: 462, y: 177, w: 4, h: 15 },
        pointer:      { x: 432, y: 16, w: 8, h: 10 },
        pointer_hand: { x: 448, y: 16, w: 12, h: 16 },
        pointer_no:   { x: 466, y: 19, w: 9, h: 8 },
        pointer_yes:  { x: 482, y: 19, w: 12, h: 9 },

        // Blank keys to put a label on, the plain one, a wide one and a space bar
        key_blank: { x: 32, y: 592, w: 16, h: 16, frames: 4, border: vec(3, 3, 3, 5), content: vec(3, 2, 3, 5) },
        key_wide:  { x: 36, y: 576, w: 24, h: 16, frames: 4, step: vec(32, 0), border: vec(3, 3, 3, 5), content: vec(3, 2, 3, 5) },
        key_long:  { x: 36, y: 608, w: 104, h: 16, frames: 4, step: vec(112, 0), border: vec(3, 3, 3, 5), content: vec(3, 2, 3, 5) }
    }
};
let keyboard_rows = [16, 129, 242, 353];
func key(name, x, w, row) {
    let frames = [];
    for (i in range(1, 4)) { frames.push(vec(x, keyboard_rows[i] + row * 16)); }
    keyboard.sprites["key_" + name] = { x: x, y: keyboard_rows[0] + row * 16, w: w, h: 16, frames: frames, time: 0.12 };
    keyboard.sprites["key_" + name + "_pressed"] = { x: x, y: keyboard_rows[2] + row * 16, w: w, h: 16 };
}
func keys_along(names, x, row) {
    for (i in range(names.count)) { key(names[i], x + i * 16, 16, row); }
}
key("esc", 32, 16, 0);
keys_along(["f1", "f2", "f3", "f4", "f5", "f6", "f7", "f8", "f9", "f10", "f11", "f12"], 64, 0);
keys_along(["grave", "1", "2", "3", "4", "5", "6", "7", "8", "9", "0", "minus", "equals"], 48, 1);
key("backspace", 260, 24, 1);
key("tab", 36, 24, 2);
keys_along(["q", "w", "e", "r", "t", "y", "u", "i", "o", "p", "lbracket", "rbracket", "backslash"], 64, 2);
key("caps", 36, 24, 3);
keys_along(["a", "s", "d", "f", "g", "h", "j", "k", "l", "semicolon", "quote"], 64, 3);
key("enter", 244, 24, 3);
key("shift", 36, 24, 4);
keys_along(["z", "x", "c", "v", "b", "n", "m", "comma", "period", "slash"], 64, 4);
key("rshift", 244, 24, 4);
key("up", 320, 16, 4);
key("ctrl", 36, 24, 5);
key("alt", 68, 24, 5);
key("space", 100, 104, 5);
key("ralt", 212, 24, 5);
key("rctrl", 244, 24, 5);
keys_along(["left", "down", "right"], 304, 5);

// The keys to the side, whose frames go to the right
let side_keys = ["insert", "home", "delete", "end", "pageup", "pagedown"];
for (i in range(side_keys.count)) {
    keyboard.sprites["key_" + side_keys[i]] = { x: 416, y: 224 + i * 16, w: 16, h: 16, frames: 4, time: 0.12 };
    keyboard.sprites["key_" + side_keys[i] + "_pressed"] = { x: 448, y: 224 + i * 16, w: 16, h: 16 };
}

// Everything above, by the name sprites are asked for.
let sheet = {
    images: {
        buttons, panels, form, bars, cursors, hearts, stars, selectors, clicks,
        xbox, playstation, keyboard
    }
}
