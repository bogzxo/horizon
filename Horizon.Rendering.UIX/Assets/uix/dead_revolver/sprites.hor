// The sprites of Dead Revolver's pixel UI pack, by name.
//
// Every image of the pack holds the same art several times over, once for every colour it comes in. A sprite is
// written down once, for the first copy, and found in the others by the theme it is asked for in:
//   block:    how wide one copy of the art is, in pixels
//   themes:   which copy every theme starts at, counted in blocks from the left of the image
//   fallback: the theme that is used when a sprite is asked for in a theme the image doesn't come in
//             (the first one listed if it doesn't say)
//   states:   the other states the art of every theme is followed by, and how many blocks along each of them is:
//             with states: { hover: 1 } every sprite of the image is there a second time as "name_hover"
//   size:     how big the sprites of the image are, for images that are a grid of them: a number or
//             vec(width, height). A sprite can still say otherwise with a w and an h of its own
// A sprite says where it is inside of its copy, in pixels from the top left:
//   x, y, w, h: the rectangle of the sprite (of its first frame, if it has several)
//   block:      how many blocks further along it is, for images that follow every theme with its other states
//   border:     how much of every edge keeps its size when the sprite is stretched as a nine-slice: a number for
//               all four sides, vec(horizontal, vertical) or vec(left, top, right, bottom)
//   content:    how far in from every edge whatever is put on top of the sprite goes, written like a border: the
//               label of a button sits on its face, not on the lip under it
//   frames:     how many frames it has, they follow each other to the right ("name#2" is the third on its own)
//   time:       how long every frame of an animation is shown for, in seconds
// A sprite can also be asked for in a theme of its own, whatever the skin's theme is: "round_blank@white".
//
// Only sprites that are used get loaded, so there is no harm in naming more of the pack here than a UI needs.
// The rectangles were measured off the images, see the pack itself for what else there is to name.

// Buttons. Every theme is followed by its other states, so every sprite here is there four times over:
// "button", "button_hover", "button_pressed" and "button_selected".
let buttons = {
    file: "buttons.png",
    block: 208,
    themes: { white: 14, dark: 18, tan: 22, gold: 26, red: 30, purple: 34, blue: 38 },
    fallback: "blue",
    states: { hover: 1, pressed: 2, selected: 3 },
    sprites: {
        button:                  { x: 16, y: 171, w: 32, h: 21, border: vec(6, 5, 6, 8), content: vec(6, 4, 6, 9) },
        button_flat:             { x: 15, y: 15, w: 34, h: 18, border: 4, content: vec(6, 5, 6, 5) },
        button_outline:          { x: 79, y: 79, w: 34, h: 18, border: 4, content: vec(6, 5, 6, 5) },
        button_pill:             { x: 47, y: 127, w: 34, h: 18, border: vec(8, 5, 8, 5), content: vec(9, 5, 9, 5) },
        button_slant:            { x: 16, y: 80, w: 48, h: 16, border: vec(18, 2, 18, 2), content: vec(16, 4, 16, 4) },
        key:                     { x: 144, y: 122, w: 32, h: 22, border: vec(8, 6, 8, 10), content: vec(8, 3, 8, 10) },
        tab_left:                { x: 64, y: 177, w: 24, h: 15, border: vec(10, 6, 3, 3) },
        tab_right:               { x: 96, y: 177, w: 24, h: 15, border: vec(3, 6, 10, 3) },
        close:                   { x: 31, y: 212, w: 13, h: 13 }
    }
};

