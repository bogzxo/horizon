// editor, laid out with Horizon.Hex.
// Load it with UILayout.Load, every component is there under the name it has here.

let root = compositor.stack({
    fill: "both",
    padding: vec(10, 12, 10, 8),
    spacing: 8
});

let toolbar = compositor.stack({
    parent: root,
    size: vec(0, 28),
    anchor: "left",
    pivot: "left",
    fill: "horizontal",
    spacing: 14,
    direction: "horizontal"
});

let menu = compositor.menu_bar({ parent: toolbar, text_scale: 0.125 });

let name_box = compositor.textbox({
    parent: toolbar,
    size: vec(220, 28),
    padding: vec(8, 6, 8, 6),
    placeholder: "name of the layout",
    text_scale: 0.125,
    max_length: 40
});

let play_button = compositor.button({
    parent: toolbar,
    size: vec(0, 28),
    tooltip: "plays the entrances of the whole layout from the start, the way loading it in a program does (F5)",
    label: "play intro animations",
    lbl_scale: 0.125
});

let coords = compositor.label({
    parent: toolbar,
    size: vec(170, 28),
    text_scale: 0.125,
    color: vec(0.46, 0.52, 0.64, 1),
    align: "left"
});

let body = compositor.stack({
    parent: root,
    anchor: "left",
    pivot: "left",
    spacing: 10,
    direction: "horizontal"
});

let left = compositor.stack({
    parent: body,
    anchor: "top",
    pivot: "top",
    spacing: 6
});

let add_title = compositor.label({
    parent: left,
    anchor: "left",
    pivot: "left",
    text: "ADD",
    text_scale: 0.125,
    color: vec(0.46, 0.52, 0.64, 1)
});

let palette = compositor.grid({
    parent: left,
    template: "palette_button.hor",
    preview_count: 19,
    spacing: 4
});

let tree_title = compositor.label({
    parent: left,
    anchor: "left",
    pivot: "left",
    text: "LAYOUT",
    text_scale: 0.125,
    color: vec(0.46, 0.52, 0.64, 1)
});

let tree_tools = compositor.stack({
    parent: left,
    anchor: "left",
    pivot: "left",
    spacing: 3,
    direction: "horizontal"
});

let move_up = compositor.button({
    parent: tree_tools,
    size: vec(44, 24),
    label: "up",
    lbl_scale: 0.125
});

let move_down = compositor.button({
    parent: tree_tools,
    size: vec(44, 24),
    label: "down",
    lbl_scale: 0.125
});

let move_out = compositor.button({
    parent: tree_tools,
    size: vec(44, 24),
    label: "out",
    lbl_scale: 0.125
});

let move_in = compositor.button({
    parent: tree_tools,
    size: vec(44, 24),
    label: "in",
    lbl_scale: 0.125
});

let duplicate = compositor.button({
    parent: tree_tools,
    size: vec(44, 24),
    label: "copy",
    lbl_scale: 0.125
});

let remove = compositor.button({
    parent: tree_tools,
    size: vec(45, 24),
    label: "del",
    lbl_scale: 0.125
});

let tree_scroll = compositor.scroll({
    parent: left,
    size: vec(280, 380),
    padding: vec(4, 4, 4, 4),
    color: vec(0.1, 0.11, 0.145, 1),
    radius: 6
});

let tree = compositor.stack({
    parent: tree_scroll,
    template: "tree_row.hor",
    preview_count: 5,
    spacing: 1
});

let layers_title = compositor.label({
    parent: left,
    anchor: "left",
    pivot: "left",
    text: "LAYERS",
    text_scale: 0.125,
    color: vec(0.46, 0.52, 0.64, 1)
});

let layers_scroll = compositor.scroll({
    parent: left,
    size: vec(280, 96),
    padding: vec(4, 4, 4, 4),
    color: vec(0.1, 0.11, 0.145, 1),
    radius: 6
});

let layers = compositor.stack({
    parent: layers_scroll,
    template: "tree_row.hor",
    preview_count: 2,
    spacing: 1
});

let center = compositor.stack({
    parent: body,
    anchor: "top",
    pivot: "top",
    spacing: 6
});

let tabs = compositor.stack({
    parent: center,
    anchor: "left",
    pivot: "left",
    template: "tab.hor",
    preview_count: 2,
    spacing: 4,
    direction: "horizontal"
});

let canvas = compositor.panel({ parent: center, size: vec(884, 497) });

let code_title = compositor.label({
    parent: center,
    anchor: "left",
    pivot: "left",
    text: "CODE",
    text_scale: 0.125,
    color: vec(0.46, 0.52, 0.64, 1)
});

let code_scroll = compositor.scroll({
    parent: center,
    pos: vec(-1.642662, 119.91173),
    size: vec(884, 250),
    padding: vec(10, 10, 10, 10),
    color: vec(0.055, 0.06, 0.08, 1),
    radius: 6
});

let code = compositor.code({
    parent: code_scroll,
    anchor: "top_left",
    pivot: "top_left",
    text_scale: 0.125
});

let right = compositor.stack({
    parent: body,
    anchor: "top",
    pivot: "top",
    spacing: 6
});

let inspector_title = compositor.label({
    parent: right,
    anchor: "left",
    pivot: "left",
    text: "PROPERTIES",
    text_scale: 0.125,
    color: vec(0.46, 0.52, 0.64, 1)
});

let inspector_scroll = compositor.scroll({
    parent: right,
    pos: vec(1.888916, -3.2853088),
    size: vec(400, 789.7115),
    padding: vec(8, 8, 8, 8),
    color: vec(0.1, 0.11, 0.145, 1),
    radius: 6
});

let inspector = compositor.stack({
    parent: inspector_scroll,
    template: "property_row.hor",
    preview_count: 6,
    spacing: 5
});

let status = compositor.label({
    parent: root,
    size: vec(400, 18),
    anchor: "left",
    pivot: "left",
    text_scale: 0.125,
    align: "left"
});
